{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++14",
                "-I${workspaceFolder}/include",
                "-I/usr/local/include",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/trajectory_smoother.cpp",
                "-L/usr/local/lib",
                "-Wl,-rpath,/usr/local/lib",
                "-losqp",
                "-o",
                "${workspaceFolder}/build/fem_smoother"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}